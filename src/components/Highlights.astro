---
/**
 * Numbered editorial selection shown right after a page's answer (the
 * `highlights` frontmatter field), e.g. "Ten tables to know" on Where to eat.
 * One column, a thin rule between entries, an optional photo on the right,
 * and, with `request`, a request button per entry (e.g. Request a table).
 */
import { Picture } from 'astro:assets';
import { photos, type PhotoKey } from '../data/photos';
import { requestCta } from '../lib/cta';
import type { RequestType } from '../lib/requests';
import type { Locale } from '../data/business';

interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  items: { name: string; place: string; kind: string; text: string; photo?: PhotoKey; alt?: string; credit?: string }[];
  request?: RequestType;
  locale: Locale;
}

const { eyebrow, title, intro, items, request, locale } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="py-section" aria-labelledby="highlights-title">
  <div class="container-site">
    <div class="max-w-2xl">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="highlights-title" class="mt-4 text-h2">{title}</h2>
      {intro && <p class="mt-5 text-taupe">{intro}</p>}
    </div>
    <ol class="mt-12 max-w-5xl">
      {items.map((x, i) => (
        <li class="grid gap-5 border-t border-line py-8 md:grid-cols-[4rem_minmax(0,1fr)_13rem] md:gap-8">
          <span class="font-serif text-3xl leading-none text-brass-deep" aria-hidden="true">{pad(i + 1)}</span>
          <div>
            <h3 class="text-3xl">{x.name}</h3>
            <p class="mt-2 text-xs font-semibold uppercase tracking-[0.14em] text-taupe">{x.place} · {x.kind}</p>
            <p class="mt-4 max-w-[60ch] text-ink">{x.text}</p>
            {request && (() => {
              const cta = requestCta(locale, { type: request }, x.name);
              return (
                <p class="mt-4 flex flex-wrap items-center gap-x-6 text-sm">
                  <a href={cta.href} class="link inline-flex min-h-11 items-center font-semibold">{cta.label}<span class="sr-only">: {x.name}</span></a>
                  <a href={cta.whatsapp} class="link inline-flex min-h-11 items-center" data-event="whatsapp_click" rel="noopener">WhatsApp<span class="sr-only">: {x.name}</span></a>
                </p>
              );
            })()}
          </div>
          {x.photo && (
            <figure>
              <Picture
                src={photos[x.photo]}
                alt={x.alt ?? ''}
                formats={['avif', 'webp']}
                widths={[400, 640]}
                sizes="(min-width: 768px) 13rem, 100vw"
                loading="lazy"
                class="aspect-[16/10] w-full object-cover md:aspect-[4/5]"
              />
              {x.credit && <figcaption class="mt-2 text-xs text-taupe">{x.credit}</figcaption>}
            </figure>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>
