---
/**
 * Private jets on /services/transfers/, kept short (owner, 25 Oct 2026: nearby
 * airports only, no list of departure cities): where jets land, and the small
 * planes that land at the altiport. No prices (src/content/transfers.ts).
 */
import { transfersCopy } from '../content/transfers';
import type { Locale } from '../data/business';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const j = transfersCopy[locale].jets;
---

<section id="private-jets" class="scroll-mt-24 bg-stone py-section" aria-labelledby="jets-title">
  <div class="container-site grid gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <p class="eyebrow">{j.eyebrow}</p>
      <h2 id="jets-title" class="mt-4 text-h2">{j.title}</h2>
      <p class="mt-5 text-taupe">{j.intro}</p>
    </div>
    <ul class="grid md:grid-cols-3 md:gap-8 lg:col-span-8 lg:self-end">
      {j.places.map((p) => (
        <li class="border-t border-brass py-5">
          <h3 class="text-2xl">{p.name}</h3>
          <p class="mt-2 text-sm">{p.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
