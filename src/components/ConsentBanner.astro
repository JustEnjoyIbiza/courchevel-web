---
/**
 * Cookie consent (CNIL): appears only when GA4 is configured and the visitor
 * has not chosen yet. "Decline" is as easy as "Accept", nothing loads before
 * a choice, and the choice can be changed from the footer link.
 */
import SmartLink from './SmartLink.astro';
import { localize } from '../lib/routes';
import type { Locale } from '../data/business';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const enabled = Boolean(import.meta.env.PUBLIC_GA4_MEASUREMENT_ID);
const c = {
  en: {
    text: 'We would like to measure visits with Google Analytics to improve this site. Nothing is collected unless you accept.',
    accept: 'Accept',
    decline: 'Decline',
    more: 'Cookie policy',
  },
  fr: {
    text: 'Nous souhaitons mesurer la fréquentation avec Google Analytics pour améliorer ce site. Rien n’est collecté sans votre accord.',
    accept: 'Accepter',
    decline: 'Refuser',
    more: 'Politique cookies',
  },
}[locale];
---

{enabled && (
  <div
    id="consent"
    class="fixed inset-x-0 bottom-14 z-50 hidden border-t border-line bg-ivory/98 shadow-[0_-8px_24px_rgba(35,27,21,0.08)] md:bottom-0"
    role="region"
    aria-label={c.more}
  >
    <div class="container-site flex flex-col gap-4 py-4 md:flex-row md:items-center md:justify-between">
      <p class="text-sm text-ink">
        {c.text} <SmartLink href={localize('/cookies/', locale)} class="link">{c.more}</SmartLink>
      </p>
      <div class="grid shrink-0 grid-cols-2 gap-3">
        <button type="button" class="btn-secondary min-h-11" data-consent="denied">{c.decline}</button>
        <button type="button" class="btn-primary min-h-11" data-consent="granted">{c.accept}</button>
      </div>
    </div>
  </div>
)}

<script>
  import { initAnalytics, getConsent, setConsent } from '../scripts/analytics';
  initAnalytics();
  const banner = document.getElementById('consent');
  if (banner && getConsent() === null) banner.classList.remove('hidden');
  banner?.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((b) =>
    b.addEventListener('click', () => {
      setConsent(b.dataset.consent as 'granted' | 'denied');
      banner.classList.add('hidden');
    }),
  );
  // Footer link "Cookie settings" reopens the banner.
  document.querySelectorAll('[data-open-consent]').forEach((el) =>
    el.addEventListener('click', (e) => {
      e.preventDefault();
      banner?.classList.remove('hidden');
    }),
  );
</script>
