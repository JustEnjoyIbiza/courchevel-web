---
/** The logo set as live text: sharper and far lighter than the 184 KB PNG. */
interface Props {
  tone?: 'ink' | 'ivory';
  size?: 'sm' | 'lg';
}
const { tone = 'ink', size = 'sm' } = Astro.props;
---

<span class:list={['inline-flex flex-col items-start leading-none', tone === 'ivory' ? 'text-ivory' : 'text-ink']}>
  <span class:list={['font-serif font-semibold uppercase tracking-[0.08em]', size === 'lg' ? 'text-3xl' : 'text-[1.35rem]']}>Courchevel</span>{' '}
  <span class:list={['mt-1 font-sans font-medium uppercase tracking-[0.32em]', size === 'lg' ? 'text-xs' : 'text-[0.625rem]']}>Luxury Concierge</span>
</span>
