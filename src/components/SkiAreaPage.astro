---
/**
 * /courchevel-ski-area/ (EN and FR): the ski area told as a descent, from the
 * summit to Le Praz. As the visitor scrolls, an altitude meter counts down and
 * a brass ski track draws itself. Both use CSS scroll-driven animations only
 * (no JavaScript); where they are not supported, or with reduced motion, the
 * page is static and the track is fully drawn. Copy: src/content/ski-area.ts.
 */
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import SmartLink from './SmartLink.astro';
import CtaBand from './CtaBand.astro';
import LastUpdated from './LastUpdated.astro';
import FaqList from './FaqList.astro';
import { photos } from '../data/photos';
import { whatsappHref, type Locale } from '../data/business';
import { skiArea, skiAreaUpdated } from '../content/ski-area';
import { photoAlt } from '../content/hub-stories';
import { t } from '../i18n/ui';
import { localize } from '../lib/routes';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = skiArea[locale];
const s = t(locale);
const other: Locale = locale === 'en' ? 'fr' : 'en';
const path = '/courchevel-ski-area/';
const nf = new Intl.NumberFormat(locale === 'en' ? 'en-GB' : 'fr-FR');

const crumbs = [
  { name: s.breadcrumbHome, href: localize('/', locale) },
  { name: c.shortTitle, href: localize(path, locale) },
];
const schema = [breadcrumbSchema(crumbs.map((x) => ({ name: x.name, url: x.href }))), faqSchema(c.faqs)];
const formats: ('avif' | 'webp')[] = ['avif', 'webp'];
---

<BaseLayout title={c.metaTitle} description={c.description} locale={locale} alternatePath={localize(path, other)} schema={schema} ogImage={photos[c.heroPhoto]}>
  <!-- Photo header -->
  <header class="relative isolate flex min-h-[calc(100svh-4rem)] items-end overflow-hidden bg-ink text-ivory md:min-h-[min(88vh,52rem)]">
    <Picture
      src={photos[c.heroPhoto]}
      alt={photoAlt[c.heroPhoto][locale]}
      formats={formats}
      widths={[480, 720, 856]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-20 h-full w-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/90 via-ink/45 to-ink/40" aria-hidden="true"></div>
    <div class="container-site pt-24 pb-14 md:pb-20">
      <Breadcrumbs items={crumbs} tone="light" />
      <p class="eyebrow mt-8 text-brass">{c.eyebrow}</p>
      <h1 class="mt-5 max-w-4xl text-[clamp(2.8rem,1.6rem+5vw,6rem)] leading-[1.0] text-ivory">{c.title}</h1>
      <p class="hero-fade mt-6 max-w-2xl font-serif text-[clamp(1.4rem,1.15rem+1vw,2.1rem)] leading-snug italic text-brass">{c.tagline}</p>
      <p class="hero-fade mt-10 text-xs font-semibold uppercase tracking-[0.22em] text-ivory/80">{c.scrollHint} <span aria-hidden="true">↓</span></p>
    </div>
  </header>

  <!-- The direct answer and the key numbers -->
  <section class="border-b border-line">
    <div class="container-site py-14 md:py-20">
      <p class="max-w-4xl font-serif text-[clamp(1.4rem,1.15rem+0.9vw,2rem)] leading-snug text-ink">{c.answer}</p>
      <dl class="mt-14 grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-4">
        {c.numbers.map((n) => (
          <div class="flex flex-col border-t border-brass pt-4">
            <dt class="mt-2 text-sm text-taupe">{n.label}</dt>
            <dd class="order-first font-serif text-5xl text-brass-deep">{n.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- The descent -->
  <section class="descent relative overflow-clip bg-ivory" aria-label={c.descentLabel}>
    <!-- Ski track: a brass line from the summit to the valley, drawn as you scroll -->
    <svg class="descent-track pointer-events-none absolute inset-0 -z-0 h-full w-full" viewBox="0 0 100 1000" preserveAspectRatio="none" aria-hidden="true">
      <path
        d="M50 0 C 90 60, 90 120, 50 170 S 10 280, 50 340 S 90 450, 50 510 S 10 620, 50 680 S 90 790, 50 850 S 30 960, 50 1000"
        pathLength="1"
        fill="none"
        stroke="var(--color-brass)"
        stroke-width="1.5"
        vector-effect="non-scaling-stroke"
      />
    </svg>

    <!-- Altitude meter: counts down from the summit as you scroll (hidden where unsupported) -->
    <div class="descent-meter pointer-events-none sticky top-28 z-10 h-0" aria-hidden="true">
      <p class="absolute left-6 flex w-28 flex-col whitespace-nowrap border-l border-brass pl-3">
        <span class="text-[0.65rem] font-semibold uppercase tracking-[0.22em] text-taupe">{c.altitudeLabel}</span>
        <span class="descent-alt font-serif text-3xl leading-tight text-ink"></span>
      </p>
    </div>

    <ol class="relative z-[1]">
      {c.stops.map((stop, i) => (
        <li class="descent-stop py-section" id={stop.id}>
          <div class="container-site">
            <article class:list={['grid gap-8 md:w-[62%] md:grid-cols-1', i % 2 === 1 ? 'md:ml-auto' : 'md:mr-auto']}>
              <div class="bg-ivory/90 md:p-2">
                <p class="font-serif text-[clamp(3.5rem,2.4rem+4.5vw,6.5rem)] leading-none text-brass-deep">{nf.format(stop.altitude)}<span class="ml-2 text-3xl">m</span></p>
                <p class="eyebrow mt-5">{stop.eyebrow}</p>
                <h2 class="mt-3 text-h2">{stop.title}</h2>
                <p class="mt-4 font-serif text-2xl leading-snug italic text-brass-deep">{stop.line}</p>
                <p class="mt-5 text-lg text-taupe">{stop.text}</p>
                {stop.facts.length > 0 && (
                  <ul class="mt-6">
                    {stop.facts.map((f) => (
                      <li class="flex gap-4 border-t border-line py-3">
                        <span class="mt-[0.8em] h-px w-3 shrink-0 bg-brass" aria-hidden="true"></span>
                        <span class="text-ink">{f}</span>
                      </li>
                    ))}
                  </ul>
                )}
                {stop.links.length > 0 && (
                  <p class="mt-6 flex flex-wrap gap-x-6 gap-y-1">
                    {stop.links.map((l) => <SmartLink href={localize(l.href, locale)} class="link inline-flex min-h-11 items-center">{l.label}</SmartLink>)}
                  </p>
                )}
              </div>
              {stop.photo && (
                <Picture
                  src={photos[stop.photo]}
                  alt={photoAlt[stop.photo][locale]}
                  formats={formats}
                  widths={[400, 600, 800]}
                  sizes="(min-width: 768px) 40vw, 100vw"
                  class="aspect-[16/10] w-full object-cover"
                />
              )}
            </article>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Practical notes -->
  <section class="bg-ink py-section text-ivory">
    <div class="container-site grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow text-brass">{c.practicalEyebrow}</p>
        <h2 class="mt-4 text-h2 text-ivory">{c.practicalTitle}</h2>
      </div>
      <dl class="lg:col-span-8">
        {c.practical.map((p) => (
          <div class="grid gap-2 border-t border-ivory/15 py-5 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-6">
            <dt class="text-sm font-semibold uppercase tracking-[0.14em] text-brass">{p.label}</dt>
            <dd class="text-stone">{p.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Ski days we arrange -->
  <section class="py-section">
    <div class="container-site grid gap-10 md:grid-cols-12 md:items-end">
      <div class="md:col-span-8">
        <p class="eyebrow">{c.arrangeEyebrow}</p>
        <h2 class="mt-4 text-h2">{c.arrangeTitle}</h2>
        <p class="mt-5 max-w-2xl text-lg text-taupe">{c.arrangeText}</p>
      </div>
      <div class="flex flex-col gap-3 md:col-span-4 md:items-end">
        <a href={localize('/enquire/', locale) + '?service=ski'} class="btn-primary w-full md:w-auto">{s.planMyStay}</a>
        <a href={whatsappHref(locale)} class="btn-secondary w-full md:w-auto" data-event="whatsapp_click" rel="noopener">{s.whatsappUs}</a>
      </div>
    </div>
    <div class="container-site mt-section max-w-4xl">
      <p class="eyebrow">{s.page.faq}</p>
      <h2 class="mt-4 text-h2">{locale === 'en' ? 'Frequently asked' : 'Questions fréquentes'}</h2>
      <div class="mt-8"><FaqList items={c.faqs} /></div>
      <p class="mt-10 text-sm text-taupe">{c.sourcesNote}</p>
      <LastUpdated date={skiAreaUpdated} locale={locale} class="mt-6" />
    </div>
  </section>

  <CtaBand locale={locale} service="ski" />
</BaseLayout>

<style>
  /* Track: fully drawn by default (static fallback). */
  .descent-track path { stroke-dasharray: 1; stroke-dashoffset: 0; }
  .descent-meter { display: none; }

  @property --alt {
    syntax: '<integer>';
    inherits: true;
    initial-value: 0;
  }

  /* The timeline is set in separate rules with longer selectors: the CSS minifier
     would otherwise fold animation-timeline into the animation shorthand, which
     browsers reject. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .descent { view-timeline-name: --descent; }
      .descent-track path {
        animation-name: draw-track;
        animation-timing-function: linear;
        animation-fill-mode: both;
      }
      .descent .descent-track path {
        animation-timeline: --descent;
        animation-range: contain 0% contain 100%;
      }
      @media (min-width: 1280px) {
        .descent-meter { display: block; }
        .descent-alt {
          counter-reset: alt var(--alt);
          animation-name: count-down;
          animation-timing-function: linear;
          animation-fill-mode: both;
        }
        .descent .descent-alt {
          animation-timeline: --descent;
          animation-range: contain 0% contain 100%;
        }
        .descent-alt::after { content: counter(alt) ' m'; }
      }
    }
  }

  @keyframes draw-track {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
  /* One keyframe per stop, evenly spaced like the stops on the page, so the meter
     reads each stop's altitude as you reach it. Keep in step with the stops in
     src/content/ski-area.ts (La Saulire 2,740 m to Le Praz 1,300 m). */
  @keyframes count-down {
    0% { --alt: 2740; }
    20% { --alt: 2077; }
    40% { --alt: 1850; }
    60% { --alt: 1650; }
    80% { --alt: 1550; }
    100% { --alt: 1300; }
  }
</style>
