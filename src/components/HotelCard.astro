---
/**
 * One hotel as a card: lead photo, name, place and label, short text. The
 * whole card links to the hotel's page (src/lib/hotels.ts). No prices.
 */
import { Picture } from 'astro:assets';
import { hotelsCopy } from '../content/hotels-page';
import type { Locale } from '../data/business';
import { hotelAlt, hotelPath, hotelPhotos, hotelSlug, type Hotel } from '../lib/hotels';

interface Props {
  hotel: Hotel;
  locale: Locale;
  heading?: 'h3' | 'h4';
}

const { hotel: h, locale, heading = 'h3' } = Astro.props;
const slug = hotelSlug(h);
const lead = hotelPhotos(slug)[0];
const Heading = heading;
---

<a href={hotelPath(slug, locale)} class="group flex h-full flex-col text-ink no-underline">
  <div class="overflow-hidden bg-stone">
    <Picture
      src={lead.src}
      alt={hotelAlt(h, lead.room, locale)}
      formats={['avif', 'webp']}
      widths={[400, 640, 960]}
      sizes="(min-width: 1024px) 30vw, (min-width: 768px) 45vw, 100vw"
      loading="lazy"
      class="aspect-[3/2] w-full object-cover transition duration-700 ease-out group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
    />
  </div>
  <Heading class="mt-5 text-2xl transition-colors group-hover:text-brass-deep">{h.data.name}</Heading>
  <p class="mt-2 text-xs font-semibold uppercase tracking-[0.14em] text-taupe">{h.data.place} · {h.data.label}</p>
  <p class="mt-3">{h.data.card}</p>
  <span class="link mt-auto inline-flex min-h-11 items-center self-start pt-3 text-sm font-semibold">{hotelsCopy[locale].see}</span>
</a>
