---
/** Photo card for one village on the Villages hub: altitude set large, name, italic line. */
import { Picture } from 'astro:assets';
import SmartLink from './SmartLink.astro';
import { photos, type PhotoKey } from '../data/photos';

interface Props {
  v: { name: string; href: string; line: string; summary: string; photo: PhotoKey; alt: string; altitudeLabel: string };
}

const { v } = Astro.props;
---

<li class="group relative overflow-hidden bg-ink">
  <Picture
    src={photos[v.photo]}
    alt={v.alt}
    formats={['avif', 'webp']}
    widths={[480, 720, 960]}
    sizes="(min-width: 640px) 50vw, 100vw"
    class="aspect-[4/5] w-full object-cover opacity-85 transition duration-700 ease-out group-hover:scale-[1.04] group-hover:opacity-100 motion-reduce:transition-none motion-reduce:group-hover:scale-100 sm:aspect-[5/6]"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/35 to-ink/60" aria-hidden="true"></div>
  <p class="absolute top-6 left-6 font-serif text-5xl leading-none text-ivory/90 md:text-6xl">{v.altitudeLabel}</p>
  <div class="absolute inset-x-0 bottom-0 px-6 pb-7">
    <h3 class="text-3xl text-ivory md:text-4xl">
      <SmartLink href={v.href} class="text-ivory no-underline after:absolute after:inset-0 hover:text-brass">{v.name}</SmartLink>
    </h3>
    <p class="mt-2 font-serif text-xl italic text-brass">{v.line}</p>
    <p class="mt-3 max-w-md text-sm text-stone">{v.summary}</p>
  </div>
</li>
