---
/** Sticky bottom bar on phones: Plan my stay + WhatsApp, always one tap away. */
import { t } from '../i18n/ui';
import { localize } from '../lib/routes';
import { whatsappHref, type Locale } from '../data/business';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
---

<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 border-t border-line bg-ivory/95 backdrop-blur-sm md:hidden" style="padding-bottom: env(safe-area-inset-bottom)">
  <a href={localize('/enquire/', locale)} class="btn-primary min-h-14 px-3">{s.planMyStay}</a>
  <a
    href={whatsappHref(locale)}
    class="btn min-h-14 px-3 text-ink"
    data-event="whatsapp_click"
    rel="noopener"
  >{s.whatsapp}</a>
</div>
