---
/**
 * One chalet as a card: lead photo, name, facts, short text and the weekly
 * price. The whole card links to the chalet's page (src/lib/chalets.ts).
 * The price sits in a [data-price] element: allowed only on chalet pages,
 * next to the note that prices vary (scripts/qa/static-check.mjs).
 */
import { Picture } from 'astro:assets';
import { chaletsCopy, type Chalet } from '../content/chalets';
import type { Locale } from '../data/business';
import { chaletPath, chaletPhotos, photoAltText } from '../lib/chalets';
import { chaletFacts, euros, weekRange } from '../lib/chalet-format';

interface Props {
  chalet: Chalet;
  locale: Locale;
  heading?: 'h3' | 'h4';
}

const { chalet: x, locale, heading = 'h4' } = Astro.props;
const c = chaletsCopy[locale];
const lead = chaletPhotos(x)[0];
const Heading = heading;
---

<a href={chaletPath(x, locale)} class="group flex h-full flex-col text-ink no-underline">
  <div class="overflow-hidden bg-stone">
    <Picture
      src={lead.src}
      alt={photoAltText(x, lead.room, locale)}
      formats={['avif', 'webp']}
      widths={[400, 640, 720, 960]}
      sizes="(min-width: 1024px) 30vw, (min-width: 768px) 45vw, (min-width: 640px) calc(100vw - 4rem), calc(100vw - 2.5rem)"
      loading="lazy"
      class="aspect-[3/2] w-full object-cover transition duration-700 ease-out group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
    />
  </div>
  <Heading class="mt-5 text-2xl transition-colors group-hover:text-brass-deep">{x.name}</Heading>
  <p class="mt-2 text-xs font-semibold uppercase tracking-[0.14em] text-taupe">{chaletFacts(x, locale)}</p>
  <p class="mt-3">{x.text[locale]}</p>
  <p class="mt-4" data-price>
    <span class="font-serif text-2xl text-brass-deep">{euros(x.price, locale)}</span>
    <span class="text-sm text-taupe"> {c.perWeek} · {weekRange(x, locale)}</span>
  </p>
  <span class="link mt-auto inline-flex min-h-11 items-center self-start pt-3 text-sm font-semibold">{c.see}</span>
</a>
