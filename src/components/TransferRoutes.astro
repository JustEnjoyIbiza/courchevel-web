---
/**
 * The transfer routes (src/content/transfers.ts) on /services/transfers/: each
 * nearby airport or resort with its helicopter flight time and price, and its
 * road time and car prices. The nearby airports are open; Milan and Turin and the
 * resorts are folded (<details>, works without JavaScript). Rows: TransferRouteList.
 * The intro carries the note that prices vary ([data-price-note]), which the static
 * check requires next to any price; [data-pending] marks the draft prices until the
 * owner confirms them (scripts/qa/launch-check.mjs).
 */
import { Picture } from 'astro:assets';
import TransferRouteList from './TransferRouteList.astro';
import { routes, routeGroups, foldedGroups, transfersCopy, pricesConfirmed } from '../content/transfers';
import { photos } from '../data/photos';
import type { Locale } from '../data/business';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = transfersCopy[locale];
const groups = routeGroups.map((group) => ({ group, items: routes.filter((r) => r.group === group) })).filter((g) => g.items.length);
const open = groups.filter((g) => !foldedGroups.includes(g.group));
const folded = groups.filter((g) => foldedGroups.includes(g.group));
---

<section id="routes" class="scroll-mt-24 py-section" aria-labelledby="routes-title">
  <div class="container-site">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow">{c.eyebrow}</p>
        <h2 id="routes-title" class="mt-4 text-h2">{c.title}</h2>
        <p class="mt-5 text-taupe" data-price-note>{c.note}</p>
        {!pricesConfirmed && <p class="mt-3 text-sm italic text-brass-deep" data-pending>{c.draft}</p>}
        <ul class="mt-8">
          {c.limits.map((l) => (
            <li class="flex gap-4 border-t border-line py-3 text-sm">
              <span class="mt-[0.7em] h-px w-3 shrink-0 bg-brass" aria-hidden="true"></span>
              <span>{l}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="grid grid-cols-2 gap-4 self-start lg:col-span-5">
        <Picture src={photos.helicopter} alt={c.photos.heli} formats={['avif', 'webp']} widths={[320, 480, 720]} sizes="(min-width: 1024px) 20vw, 50vw" loading="lazy" class="aspect-[4/5] w-full object-cover" />
        <Picture src={photos['van-snow']} alt={c.photos.car} formats={['avif', 'webp']} widths={[320, 480, 720]} sizes="(min-width: 1024px) 20vw, 50vw" loading="lazy" class="aspect-[4/5] w-full object-cover" />
      </div>
    </div>

    {open.map((g) => (
      <div class="mt-16">
        <h3 class="text-3xl">{c.groups[g.group]}</h3>
        <TransferRouteList items={g.items} locale={locale} />
      </div>
    ))}

    <div class="mt-12 border-b border-line md:mt-16">
      {folded.map((g) => (
        <details class="group/fold border-t border-line">
          <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-6 py-6 transition-colors hover:text-brass-deep [&::-webkit-details-marker]:hidden">
            <h3 class="text-2xl md:text-3xl">{c.groups[g.group]}</h3>
            <span class="shrink-0 text-sm">
              <span class="text-taupe">{c.count(g.items.length)}</span>
              <span class="link ml-3 font-semibold group-open/fold:hidden">{c.show}</span>
              <span class="link ml-3 hidden font-semibold group-open/fold:inline">{c.hide}</span>
            </span>
          </summary>
          <div class="pb-6">
            <TransferRouteList items={g.items} locale={locale} />
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
