---
/**
 * Homepage quick-start: dates, village and group size, sent with a plain GET
 * to /enquire/, which arrives pre-filled (netlify/edge-functions/enquire-prefill.ts,
 * and src/scripts/enquiry-form.ts when JavaScript runs). No script on the homepage.
 */
import { home } from '../../content/home';
import { enquiry } from '../../content/enquiry';
import { VILLAGES } from '../../lib/lead';
import { villageLabels } from '../../lib/lead-labels';
import { localize } from '../../lib/routes';
import type { Locale } from '../../data/business';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = home[locale].quickStart;
const f = enquiry[locale];
const today = new Date().toISOString().slice(0, 10);
const id = (name: string) => `qs-${name}`;

const label = 'block text-xs font-semibold uppercase tracking-[0.14em] text-taupe';
const input =
  'mt-2 block w-full min-h-12 border border-line bg-white px-3 py-2 text-base text-ink focus:border-ink focus:outline-none focus-visible:outline-2 focus-visible:outline-brass-deep';
---

<form method="get" action={`${localize('/enquire/', locale)}#form`} class="quick-start mt-10 border-t border-line pt-8" aria-labelledby="qs-title">
  <h2 id="qs-title" class="font-serif text-2xl text-ink">{c.title}</h2>
  <div class="mt-5 grid grid-cols-2 gap-x-4 gap-y-5">
    <div>
      <label class={label} for={id('arrival')}>{f.arrival}</label>
      <input class={input} id={id('arrival')} name="arrival" type="date" min={today} />
    </div>
    <div>
      <label class={label} for={id('departure')}>{f.departure}</label>
      <input class={input} id={id('departure')} name="departure" type="date" min={today} />
    </div>
    <div class="col-span-2 sm:col-span-1">
      <label class={label} for={id('village')}>{c.village}</label>
      <select class={input} id={id('village')} name="village">
        <option value="">{c.villagePlaceholder}</option>
        {VILLAGES.map((v) => <option value={v}>{villageLabels[locale][v]}</option>)}
      </select>
    </div>
    <div class="col-span-2 grid grid-cols-2 gap-x-4 sm:col-span-1">
      <div>
        <label class={label} for={id('adults')}>{f.adults}</label>
        <input class={input} id={id('adults')} name="adults" type="number" inputmode="numeric" min="1" max="99" value="2" />
      </div>
      <div>
        <label class={label} for={id('children')}>{f.children}</label>
        <input class={input} id={id('children')} name="children" type="number" inputmode="numeric" min="0" max="99" value="0" />
      </div>
    </div>
  </div>
  <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
    <button type="submit" class="btn-primary">{c.submit}</button>
    <slot />
  </div>
  <p class="mt-3 text-sm text-taupe">{c.note}</p>
</form>
