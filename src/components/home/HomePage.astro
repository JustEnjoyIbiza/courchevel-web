---
/**
 * The homepage, shared by / and /fr/. Copy comes from src/content/home.ts,
 * services/villages/faq from src/data/. Section ids keep the old site's
 * anchors (#services, #about, #contact...) working.
 *
 * The story (owner, 26 Oct 2026; docs/homepage-and-visibility-plan.md): the feeling
 * (hero), who we are (introduction and one trust line), what we arrange (services),
 * the moments (experiences), how simple it is (three steps, then the dates form),
 * proof and people (Google rating, real reviews, the founder), before you come
 * (villages and guides as short link rows), questions, the closing invitation.
 */
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SmartLink from '../SmartLink.astro';
import QuickStart from './QuickStart.astro';
import { home } from '../../content/home';
import { services, servicePath } from '../../data/services';
import { villages } from '../../data/villages';
import { allFaqs } from '../../content/faq';
import { experiencesPage } from '../../content/experiences-page';
import { photos } from '../../data/photos';
import { reviews } from '../../data/reviews';
import { business, whatsappHref, type Locale } from '../../data/business';
import { t } from '../../i18n/ui';
import { localize, splitId } from '../../lib/routes';
import { googleRating } from '../../lib/google-rating';
import { getImage } from 'astro:assets';
import { localBusinessSchema, faqSchema, breadcrumbSchema, websiteSchema } from '../../lib/schema';

import heroImg from '../../assets/photos/rolls-royce-helicopter-arrival.jpeg';
import stepsImg from '../../assets/photos/chalet-gift-delivery.jpeg';
// The palaces half of the split chalets tile (hotel's photo, credited on the tile).
import palaceImg from '../../assets/hotels/airelles-courchevel/01-exterior.jpeg';
import aboutImg from '../../assets/photos/defender-luggage-snow.jpeg';
import finalImg from '../../assets/photos/courchevel-sculpture.jpeg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = home[locale];
const s = t(locale);
const other: Locale = locale === 'en' ? 'fr' : 'en';
const enquire = localize('/enquire/', locale);
const homeFaqs = allFaqs(locale).filter((f) => f.home).map(({ q, a }) => ({ q, a }));
// Three experiences from /experiences/, chosen so no photo repeats on the homepage.
const featured = ['private-skiing', 'groomer-dinner', 'mountain-evenings'].map((id) => experiencesPage[locale].experiences.find((x) => x.id === id)!);
// Before you come: every village as one row of links, and four guides (the rest are on /guides/).
const homeGuideSlugs = ['getting-to-courchevel', 'where-to-eat', 'courchevel-with-kids', 'season-dates-and-events'];
const guides = (await getCollection('guides'))
  .filter((g) => splitId(g.id).locale === locale && homeGuideSlugs.includes(splitId(g.id).slug))
  .sort((a, b) => homeGuideSlugs.indexOf(splitId(a.id).slug) - homeGuideSlugs.indexOf(splitId(b.id).slug))
  .map((g) => ({ title: g.data.shortTitle ?? g.data.title, href: localize(`/guides/${splitId(g.id).slug}/`, locale) }));

// Proof: the Google rating (live, or last checked by hand with its date) and the founder once known.
const rating = await googleRating(locale);
const tag = locale === 'en' ? 'en-GB' : 'fr-FR';
const ratingText = new Intl.NumberFormat(tag, { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(rating.value);
const ratingChecked = rating.checked ? new Intl.DateTimeFormat(tag, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(rating.checked)) : null;
const founder = business.founder;
const languageNames = new Intl.DisplayNames([tag], { type: 'language' });
const pad = (n: number) => String(n).padStart(2, '0');
const serviceEntries = (await getCollection('services')).filter((e) => splitId(e.id).locale === locale);
const featuredSlugs = [
  { slug: 'chalets', image: 'chalet-living-room' },
  { slug: 'transfers', image: 'private-jet' },
  { slug: 'private-chef', image: 'dining-table' },
] as const;
const featuredServices = featuredSlugs.map(({ slug, image }) => {
  const svc = services.find((x) => x.slug === slug)!;
  // Alt text comes from the service page that uses the same photo, in this language.
  const alt = serviceEntries.find((e) => e.data.image === image)?.data.imageAlt ?? '';
  return { svc, image, alt };
});
// Palace hotels already have the second half of the chalets tile.
const otherServices = services.filter((x) => x.slug !== 'palace-hotels' && !featuredSlugs.some((f) => f.slug === x.slug));
// The "something else" request fills the rest of the index's last row (2 columns from sm, 3 from lg).
const requestSpan = `${['sm:col-span-2', 'sm:col-span-1'][otherServices.length % 2]} ${['lg:col-span-3', 'lg:col-span-2', 'lg:col-span-1'][otherServices.length % 3]}`;

const heroForSchema = (await getImage({ src: heroImg, width: 1200, format: 'jpeg' })).src;
const schema = [
  websiteSchema(locale),
  localBusinessSchema(locale, { image: heroForSchema }),
  faqSchema(homeFaqs),
  breadcrumbSchema([{ name: s.breadcrumbHome, url: localize('/', locale) }]),
];

const formats: ('avif' | 'webp')[] = ['avif', 'webp'];
const sectionHead = 'max-w-2xl';
---

<BaseLayout
  title={c.meta.title}
  description={c.meta.description}
  locale={locale}
  alternatePath={localize('/', other)}
  schema={schema}
  ctaAfter="hero"
>
  <!-- Hero: one full-screen photo, everything centred on it -->
  <section id="hero" class="relative isolate flex min-h-[calc(100svh-4rem)] items-center justify-center overflow-hidden bg-ink text-ivory md:min-h-[min(92vh,58rem)]">
    <Picture
      src={photos['hot-tub']}
      alt={c.hero.imageAlt}
      formats={formats}
      widths={[480, 720, 800, 1000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-20 h-full w-full object-cover object-[center_55%]"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-ink/75 via-ink/65 to-ink/90 md:from-ink/70 md:via-ink/45 md:to-ink/85" aria-hidden="true"></div>
    <div class="mx-auto flex max-w-4xl flex-col items-center px-5 py-20 text-center sm:px-8">
      <!-- One H1: the company's name, "Courchevel" then "Luxury Concierge" in brass. -->
      <h1 class="text-[clamp(2.9rem,1.6rem+5.2vw,6.25rem)] leading-[1.02] text-ivory">
        {c.hero.headline[0]} <em class="block text-brass">{c.hero.headline[1]}</em>
      </h1>
      <div class="rule mt-10"></div>
      <p class="hero-fade mt-8 max-w-xl text-ivory/85">{c.hero.short}</p>
      <div class="hero-fade mt-10 flex w-full flex-col items-center gap-4 sm:w-auto">
        <a href={enquire} class="btn w-full bg-ivory text-ink hover:bg-brass sm:w-auto">{s.planMyStay}</a>
        <a href={whatsappHref(locale)} class="inline-flex min-h-11 items-center text-sm text-ivory underline decoration-brass underline-offset-4 hover:text-brass" data-event="whatsapp_click" rel="noopener">{c.hero.whatsapp}</a>
      </div>
    </div>
  </section>

  <!-- Introduction: who we are in one breath (names the company once), then one quiet line of facts -->
  <section class="border-b border-line pt-section pb-14 md:pb-16">
    <div class="container-site">
      <p class="mx-auto max-w-4xl text-center font-serif text-[clamp(1.45rem,1.15rem+1vw,2.1rem)] leading-snug text-ink">{c.hero.lead}</p>
      <ul class="mx-auto mt-10 flex max-w-4xl flex-col items-center gap-1 text-center text-sm text-taupe md:flex-row md:flex-wrap md:justify-center md:gap-x-3 md:gap-y-2">
        {[
          { text: c.trust.rating(ratingText, rating.count), href: business.profiles.google.mapsUrl },
          { text: c.trust.reply },
          { text: c.trust.season },
          { text: c.trust.based },
        ].map((item, i) => (
          <li class="inline-flex items-center gap-3">
            {i > 0 && <span class="hidden text-brass md:inline" aria-hidden="true">·</span>}
            {item.href ? (
              <a href={item.href} rel="noopener" class="link inline-flex min-h-11 items-center gap-1.5"><span class="text-brass-deep" aria-hidden="true">★</span>{item.text}</a>
            ) : (
              <span class="inline-flex items-center py-1 md:min-h-11 md:py-0">{item.text}</span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Services: three large photo tiles, then the others as an index -->
  <section id="services" class="pt-14 pb-section md:pt-16">
    <div class="container-site">
      <div class={sectionHead}>
        <p class="eyebrow">{c.services.eyebrow}</p>
        <h2 class="mt-4 text-h2">{c.services.title}</h2>
        <p class="mt-5 text-taupe">{c.services.intro}</p>
      </div>
      <ul class="mt-14 grid gap-5 md:grid-cols-3 md:gap-6">
        {featuredServices.map((f) => f.svc.slug === 'chalets' ? (
          // Split in two (owner, 25 Oct 2026): chalets | palace hotels, each half its own link and
          // photo. Side by side from md, stacked on phones so each choice reads on its own.
          <li class="relative overflow-hidden bg-ink">
            <h3 class="sr-only">{f.svc.name[locale]}</h3>
            <div class="grid grid-rows-2 md:aspect-[4/5] md:grid-cols-2 md:grid-rows-1">
              {[
                { href: localize('/services/chalets/', locale), img: photos[f.image], alt: f.alt, credit: undefined, ...c.services.split.chalets },
                { href: localize('/palace-hotels-courchevel/', locale), img: palaceImg, ...c.services.split.hotels },
              ].map((half, i) => (
                <SmartLink href={half.href} class={`group/half relative block overflow-hidden no-underline ${i ? 'border-t border-brass/40 md:border-t-0 md:border-l' : ''}`}>
                  <Picture
                    src={half.img}
                    alt={half.alt}
                    formats={formats}
                    widths={[400, 640, 720, 800]}
                    sizes="(min-width: 768px) 17vw, (min-width: 640px) calc(100vw - 4rem), calc(100vw - 2.5rem)"
                    class="aspect-[4/3] h-full w-full object-cover opacity-90 transition duration-700 ease-out group-hover/half:scale-[1.04] group-hover/half:opacity-100 motion-reduce:transition-none motion-reduce:group-hover/half:scale-100 md:aspect-auto"
                  />
                  <span class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-ink via-ink/60 to-transparent" aria-hidden="true"></span>
                  <span class="absolute inset-x-0 bottom-0 flex flex-col items-start px-5 pb-6 sm:px-6">
                    <span class="inline-flex min-h-11 items-center bg-ink/80 px-4 font-serif text-2xl text-brass ring-1 ring-brass/60 transition-colors duration-300 group-hover/half:bg-brass-deep group-hover/half:text-ivory">{half.label}</span>
                    <span class="mt-2 text-sm text-stone">{half.line}</span>
                  </span>
                  {half.credit && <span class="absolute top-2 right-3 text-[0.7rem] text-ivory/80">{half.credit}</span>}
                </SmartLink>
              ))}
            </div>
          </li>
        ) : (
          <li class="group relative overflow-hidden bg-ink">
            <Picture
              src={photos[f.image]}
              alt={f.alt}
              formats={formats}
              widths={[400, 600, 720, 800]}
              sizes="(min-width: 768px) 33vw, (min-width: 640px) calc(100vw - 4rem), calc(100vw - 2.5rem)"
              class="aspect-[5/4] w-full object-cover opacity-90 transition duration-700 ease-out group-hover:scale-[1.04] group-hover:opacity-100 motion-reduce:transition-none motion-reduce:group-hover:scale-100 md:aspect-[4/5]"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink via-ink/70 to-transparent px-6 pt-14 pb-6 md:pt-24 md:pb-7">
              <h3 class="text-3xl text-ivory">
                <SmartLink href={localize(servicePath(f.svc), locale)} class="text-ivory no-underline after:absolute after:inset-0 hover:text-brass">{f.svc.name[locale]}</SmartLink>
              </h3>
              <p class="mt-2 text-sm text-stone">{f.svc.summary[locale]}</p>
            </div>
          </li>
        ))}
      </ul>
      <p class="eyebrow mt-16">{c.services.more}</p>
      <ul class="mt-6 grid gap-x-12 sm:grid-cols-2 lg:grid-cols-3">
        {otherServices.map((svc) => (
          <li class="border-t border-line py-5">
            <h3 class="text-xl">
              <SmartLink href={localize(servicePath(svc), locale)} class="text-ink no-underline hover:text-brass-deep">{svc.name[locale]}</SmartLink>
            </h3>
            <p class="mt-1 text-sm text-taupe">{svc.summary[locale]}</p>
          </li>
        ))}
        <li class={`border-t border-line py-5 ${requestSpan}`}>
          <div class="flex h-full flex-col items-start justify-center gap-4 bg-stone p-5 md:p-6 lg:flex-row lg:items-center lg:justify-between">
            <div>
              <p class="font-serif text-xl text-ink">{c.services.other.title}</p>
              <p class="mt-1 text-sm text-taupe">{c.services.other.text}</p>
            </div>
            <a href={enquire} class="btn-primary shrink-0">{s.planMyStay}</a>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- Signature experiences -->
  <section id="experiences" class="border-t border-line bg-stone py-section">
    <span id="packages" aria-hidden="true"></span>
    <div class="container-site">
      <div class={sectionHead}>
        <p class="eyebrow">{c.experiences.eyebrow}</p>
        <h2 class="mt-4 text-h2">{c.experiences.title}</h2>
      </div>
    </div>
    <ul class="container-site mt-12 flex snap-x snap-mandatory scroll-pl-5 gap-5 overflow-x-auto pb-4 sm:scroll-pl-8 md:grid md:grid-cols-3 md:gap-8 md:overflow-visible md:pb-0">
      {featured.map((x) => (
        <li class="w-[82%] shrink-0 snap-start md:w-auto">
          <Picture
            src={photos[x.photo ?? 'gondola']}
            alt={x.alt ?? ''}
            formats={formats}
            widths={[360, 540, 720]}
            sizes="(min-width: 768px) 33vw, 82vw"
            class="aspect-[4/5] w-full object-cover"
          />
          <h3 class="mt-6 text-3xl">
            <SmartLink href={localize('/experiences/', locale)} class="text-ink no-underline hover:text-brass-deep">{x.title}</SmartLink>
          </h3>
          <p class="mt-3 text-taupe">{x.short}</p>
        </li>
      ))}
    </ul>
    <div class="container-site mt-10">
      <SmartLink href={localize('/experiences/', locale)} class="btn-secondary">{experiencesPage[locale].hero.secondary}</SmartLink>
    </div>
  </section>

  <!-- How it works: dark band, the heading, then the photo beside three steps with large numerals -->
  <section class="bg-ink py-section text-ivory">
    <div class="container-site">
      <div class={sectionHead}>
        <p class="eyebrow text-brass">{c.steps.eyebrow}</p>
        <h2 class="mt-4 text-h2 text-ivory">{c.steps.title}</h2>
      </div>
      <div class="mt-12 grid gap-14 lg:grid-cols-12 lg:items-center">
        <div class="hidden lg:col-span-4 lg:block">
          <Picture
            src={stepsImg}
            alt={c.steps.imageAlt}
            formats={formats}
            widths={[400, 600, 800]}
            sizes="(min-width: 1024px) 28vw, 100vw"
            class="aspect-[4/5] w-full object-cover"
          />
        </div>
        <ol class="grid gap-8 md:grid-cols-3 md:gap-10 lg:col-span-8">
          {c.steps.items.map((step, i) => (
            <li class="border-t border-brass/60 pt-6">
              <span class="block font-serif text-5xl leading-none text-brass md:text-7xl" aria-hidden="true">{pad(i + 1)}</span>
              <h3 class="mt-6 text-2xl text-ivory">{step.title}</h3>
              <p class="mt-3 text-stone/85">{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- The dates form, once the visitor knows what we do and how: dates, village and group size,
       continuing into the enquiry form; "Just one thing?" links under it -->
  <section aria-label={c.quickStart.title} class="border-b border-line bg-ivory">
    <div class="container-site py-12 md:py-16">
      <QuickStart locale={locale} />
    </div>
  </section>

  <!-- Proof and people: who looks after you, the Google rating, real reviews once supplied, the founder once known.
       Keeps the old site's #about and #testimonials anchors. -->
  <section id="about" class="py-section">
    <span id="testimonials" aria-hidden="true"></span>
    <div class="container-site grid gap-12 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-7">
        <p class="eyebrow">{c.about.eyebrow}</p>
        <h2 class="mt-4 text-h2">{c.about.title}</h2>
        <p class="mt-6 text-lg text-taupe">{c.about.text}</p>
        {founder.name && (
          <div class="mt-8 border-l-2 border-brass pl-5">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-taupe">{c.about.founder.contact}</p>
            <p class="mt-1 font-serif text-2xl">{founder.name}</p>
            <p class="mt-1 text-sm text-taupe">
              {[
                founder.sinceYear ? c.about.founder.since(founder.sinceYear) : '',
                founder.languages.length ? c.about.founder.speaks(new Intl.ListFormat(tag, { type: 'conjunction' }).format(founder.languages.map((l) => languageNames.of(l) ?? l))) : '',
              ].filter(Boolean).join(' · ')}
            </p>
          </div>
        )}
        <p class="mt-6"><SmartLink href={localize('/about/', locale)} class="link inline-flex min-h-11 items-center">{c.about.link}</SmartLink></p>
        <div class="mt-8 bg-stone p-6 md:p-8" {...(rating.checked ? { 'data-rating-checked': rating.checked } : {})}>
          <p class="eyebrow">{c.about.rating.eyebrow}</p>
          <div class="mt-4 flex flex-wrap items-end gap-x-10 gap-y-3">
            <div>
              <p class="flex items-baseline gap-3">
                <span class="font-serif text-6xl leading-none text-brass-deep">{ratingText}</span>
                <span class="text-taupe">{c.about.rating.outOf}</span>
              </p>
              <p class="mt-2 text-xl tracking-[0.2em] text-brass" aria-hidden="true">{'★'.repeat(Math.round(rating.value))}</p>
            </div>
            <div>
              <p class="text-sm text-taupe">{c.about.rating.count(rating.count)}{ratingChecked && <span> · {c.about.rating.checked(ratingChecked)}</span>}</p>
              <a href={business.profiles.google.mapsUrl} rel="noopener" class="link mt-1 inline-flex min-h-11 items-center text-sm font-semibold">{c.about.rating.read}</a>
            </div>
          </div>
        </div>
      </div>
      <div class="relative hidden md:col-span-5 md:block">
        <Picture
          src={aboutImg}
          alt={c.about.imageAlt}
          formats={formats}
          widths={[400, 600, 900]}
          sizes="(min-width: 768px) 40vw, 100vw"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>
    </div>
    {reviews.length > 0 && (
      <div class="container-site mt-16 grid gap-10 md:grid-cols-3">
        {reviews.slice(0, 3).map((r) => (
          <figure class="border-t border-brass pt-6">
            <blockquote class="font-serif text-2xl leading-snug">“{r.text}”</blockquote>
            <figcaption class="mt-4 text-sm text-taupe">{r.author}, {r.service[locale]}, {r.date}</figcaption>
          </figure>
        ))}
      </div>
    )}
  </section>

  <!-- Before you come: every village and four guides as short link rows, and the festive season line.
       Keeps the village names and the internal links that search engines use, at a fraction of the height. -->
  <section id="villages" class="border-t border-line bg-stone py-section">
    <div class="container-site">
      <div class={sectionHead}>
        <p class="eyebrow">{c.plan.eyebrow}</p>
        <h2 class="mt-4 text-h2">{c.plan.title}</h2>
      </div>
      <div class="mt-12 grid gap-12 md:grid-cols-2 md:gap-16">
        <div>
          <h3 class="font-sans text-xs font-semibold uppercase tracking-[0.14em] text-taupe">{c.plan.villages}</h3>
          <p class="mt-3 text-taupe">{c.plan.villagesNote}</p>
          <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-1">
            {villages.map((v) => (
              <li><SmartLink href={localize(`/${v.slug}/`, locale)} class="inline-flex min-h-11 items-center font-serif text-xl text-ink no-underline hover:text-brass-deep">{v.name}</SmartLink></li>
            ))}
          </ul>
          <p class="mt-2"><SmartLink href={localize('/villages/', locale)} class="link inline-flex min-h-11 items-center text-sm">{c.plan.villagesAll}</SmartLink></p>
        </div>
        <div>
          <h3 class="font-sans text-xs font-semibold uppercase tracking-[0.14em] text-taupe">{c.plan.guides}</h3>
          <ul class="mt-4">
            {guides.map((g) => (
              <li class="border-t border-line first:border-t-0"><a href={g.href} class="flex min-h-11 items-center py-2 font-serif text-xl text-ink no-underline hover:text-brass-deep">{g.title}</a></li>
            ))}
          </ul>
          <p class="mt-2"><a href={localize('/guides/', locale)} class="link inline-flex min-h-11 items-center text-sm">{c.plan.guidesAll}</a></p>
        </div>
      </div>
      <p class="mt-12 border-t border-line pt-6 text-sm text-ink">
        {c.seasonal.text}
        <SmartLink href={localize('/christmas-new-year-courchevel/', locale)} class="link ml-1 inline-flex min-h-11 items-center">{c.seasonal.link}</SmartLink>
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="border-t border-line py-section">
    <div class="container-site grid gap-12 md:grid-cols-12">
      <div class="md:sticky md:top-28 md:col-span-4 md:self-start">
        <p class="eyebrow">{c.faq.eyebrow}</p>
        <h2 class="mt-4 text-h2">{c.faq.title}</h2>
        <p class="mt-6"><SmartLink href={localize('/faq/', locale)} class="link">{c.faq.more}</SmartLink></p>
      </div>
      <div class="md:col-span-8">
        {homeFaqs.map((f) => (
          <details class="group border-t border-line py-4 last:border-b md:py-6">
            <summary class="flex min-h-11 cursor-pointer list-none items-start justify-between gap-6 py-1 font-serif text-2xl [&::-webkit-details-marker]:hidden">
              <h3 class="text-2xl">{f.q}</h3>
              <span class="mt-1 text-brass-deep transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-4 max-w-2xl text-taupe">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section id="contact" class="bg-ink text-ivory">
    <div class="mx-auto grid max-w-[96rem] md:grid-cols-2">
      <div class="flex flex-col justify-center px-5 py-section sm:px-8 md:px-12 lg:px-20">
        <h2 class="text-h2 text-ivory">{c.final.title}</h2>
        <p class="mt-6 text-lg text-stone">{c.final.text}</p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href={enquire} class="btn bg-ivory text-ink hover:bg-brass">{s.planMyStay}</a>
          <a href={whatsappHref(locale)} class="btn-light" data-event="whatsapp_click" rel="noopener">{s.whatsappUs}</a>
        </div>
      </div>
      <div class="relative hidden md:block md:min-h-[36rem]">
        <Picture
          src={finalImg}
          alt={c.final.imageAlt}
          formats={formats}
          widths={[480, 720, 961]}
          sizes="(min-width: 768px) 50vw, 100vw"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>
    </div>
  </section>
</BaseLayout>
