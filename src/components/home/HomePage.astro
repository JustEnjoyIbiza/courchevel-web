---
/**
 * The homepage, shared by / and /fr/. Copy comes from src/content/home.ts,
 * services/villages/faq from src/data/. Section ids keep the old site's
 * anchors (#services, #about, #contact...) working.
 */
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SmartLink from '../SmartLink.astro';
import GoogleReviews from '../GoogleReviews.astro';
import QuickStart from './QuickStart.astro';
import { home } from '../../content/home';
import { services } from '../../data/services';
import { villages } from '../../data/villages';
import { allFaqs } from '../../content/faq';
import { experiencesPage } from '../../content/experiences-page';
import { photos } from '../../data/photos';
import { reviews } from '../../data/reviews';
import { whatsappHref, type Locale } from '../../data/business';
import { t } from '../../i18n/ui';
import { localize, splitId } from '../../lib/routes';
import { getImage } from 'astro:assets';
import { localBusinessSchema, faqSchema, breadcrumbSchema, websiteSchema } from '../../lib/schema';

import heroImg from '../../assets/photos/rolls-royce-helicopter-arrival.jpeg';
import stepsImg from '../../assets/photos/chalet-gift-delivery.jpeg';
import villagesImg from '../../assets/photos/wooden-chalets-gondola.jpeg';
import aboutImg from '../../assets/photos/defender-luggage-snow.jpeg';
import finalImg from '../../assets/photos/courchevel-sculpture.jpeg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = home[locale];
const s = t(locale);
const other: Locale = locale === 'en' ? 'fr' : 'en';
const enquire = localize('/enquire/', locale);
const homeFaqs = allFaqs(locale).filter((f) => f.home).map(({ q, a }) => ({ q, a }));
// Three experiences from /experiences/, chosen so no photo repeats on the homepage.
const featured = ['private-skiing', 'groomer-dinner', 'mountain-evenings'].map((id) => experiencesPage[locale].experiences.find((x) => x.id === id)!);
const courchevelVillages = villages.filter((v) => v.group === 'courchevel');
// The concierge checklist stays on /guides/ and in search, not on the homepage:
// visitors here have already found us (owner, 24 Oct 2026).
const homeGuideExclude = ['how-to-choose-a-concierge-in-courchevel'];
const guides = (await getCollection('guides'))
  .filter((g) => splitId(g.id).locale === locale && !homeGuideExclude.includes(splitId(g.id).slug))
  .map((g) => ({ title: g.data.shortTitle ?? g.data.title, text: g.data.description, href: localize(`/guides/${splitId(g.id).slug}/`, locale) }));
const pad = (n: number) => String(n).padStart(2, '0');
const serviceEntries = (await getCollection('services')).filter((e) => splitId(e.id).locale === locale);
const featuredSlugs = [
  { slug: 'chalets', image: 'chalet-living-room' },
  { slug: 'transfers', image: 'private-jet' },
  { slug: 'private-chef', image: 'dining-table' },
] as const;
const featuredServices = featuredSlugs.map(({ slug, image }) => {
  const svc = services.find((x) => x.slug === slug)!;
  // Alt text comes from the service page that uses the same photo, in this language.
  const alt = serviceEntries.find((e) => e.data.image === image)?.data.imageAlt ?? '';
  return { svc, image, alt };
});
const otherServices = services.filter((x) => !featuredSlugs.some((f) => f.slug === x.slug));

const heroForSchema = (await getImage({ src: heroImg, width: 1200, format: 'jpeg' })).src;
const schema = [
  websiteSchema(locale),
  localBusinessSchema(locale, { image: heroForSchema }),
  faqSchema(homeFaqs),
  breadcrumbSchema([{ name: s.breadcrumbHome, url: localize('/', locale) }]),
];

const formats: ('avif' | 'webp')[] = ['avif', 'webp'];
const sectionHead = 'max-w-2xl';
---

<BaseLayout
  title={c.meta.title}
  description={c.meta.description}
  locale={locale}
  alternatePath={localize('/', other)}
  schema={schema}
>
  <!-- Hero: one full-screen photo, everything centred on it -->
  <section id="hero" class="relative isolate flex min-h-[calc(100svh-4rem)] items-center justify-center overflow-hidden bg-ink text-ivory md:min-h-[min(92vh,58rem)]">
    <Picture
      src={photos['hot-tub']}
      alt={c.hero.imageAlt}
      formats={formats}
      widths={[480, 720, 1000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-20 h-full w-full object-cover object-[center_55%]"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-ink/75 via-ink/65 to-ink/90 md:from-ink/70 md:via-ink/45 md:to-ink/85" aria-hidden="true"></div>
    <div class="mx-auto flex max-w-4xl flex-col items-center px-5 py-20 text-center sm:px-8">
      <p class="eyebrow text-brass">{c.hero.eyebrow}</p>
      <div class="rule mt-8"></div>
      <h1 class="mt-8 text-[clamp(2.9rem,1.6rem+5.2vw,6.25rem)] leading-[1.0] text-ivory">{c.hero.title}</h1>
      <p class="hero-fade mt-8 max-w-2xl font-serif text-[clamp(1.45rem,1.15rem+1.1vw,2.2rem)] leading-snug italic text-brass">{c.hero.tagline}</p>
      <p class="hero-fade mt-6 max-w-xl text-ivory/85">{c.hero.short}</p>
      <div class="hero-fade mt-10 flex w-full flex-col items-stretch gap-3 sm:w-auto sm:flex-row sm:justify-center">
        <a href={enquire} class="btn bg-ivory text-ink hover:bg-brass">{s.planMyStay}</a>
        <a href={whatsappHref(locale)} class="btn-light" data-event="whatsapp_click" rel="noopener">{s.whatsappUs}</a>
      </div>
    </div>
  </section>

  <!-- Quick-start: dates, village and group size, continuing into the enquiry form -->
  <section aria-label={c.quickStart.title} class="border-b border-line bg-ivory">
    <div class="container-site py-10 md:py-12">
      <QuickStart locale={locale} />
    </div>
  </section>

  <!-- Statement: the direct answer, then the key facts -->
  <section class="py-section">
    <div class="container-site">
      <div class="rule mx-auto"></div>
      <p class="mx-auto mt-10 max-w-4xl text-center font-serif text-[clamp(1.45rem,1.15rem+1vw,2.1rem)] leading-snug text-ink">{c.hero.lead}</p>
      <dl class="mx-auto mt-16 grid max-w-5xl grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-4">
        {c.proof.map((p) => (
          <div class="flex flex-col items-center text-center">
            <dt class="mt-3 text-sm text-taupe">{p.label}</dt>
            <dd class="order-first font-serif text-5xl font-medium text-brass-deep md:text-6xl">{p.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Seasonal: Christmas and New Year (shown once that page exists) -->
  <div class="border-b border-line">
    <p class="container-site py-5 text-sm text-ink">
      {c.seasonal.text}
      <SmartLink href={localize('/christmas-new-year-courchevel/', locale)} class="link ml-1 inline-flex min-h-11 items-center">{c.seasonal.link}</SmartLink>
    </p>
  </div>

  <!-- Services: three large photo tiles, then the other nine as an index -->
  <section id="services" class="py-section">
    <div class="container-site">
      <div class={sectionHead}>
        <p class="eyebrow">{c.services.eyebrow}</p>
        <h2 class="mt-4 text-h2">{c.services.title}</h2>
        <p class="mt-5 text-taupe">{c.services.intro}</p>
      </div>
      <ul class="mt-14 grid gap-5 md:grid-cols-3 md:gap-6">
        {featuredServices.map((f) => f.svc.slug === 'chalets' ? (
          // Split in two (owner, 25 Oct 2026): chalets | palace hotels, each half its own link.
          <li class="group relative overflow-hidden bg-ink">
            <Picture
              src={photos[f.image]}
              alt={f.alt}
              formats={formats}
              widths={[400, 600, 800]}
              sizes="(min-width: 768px) 33vw, 100vw"
              class="aspect-[4/5] w-full object-cover opacity-90 transition duration-700 ease-out group-hover:scale-[1.04] group-hover:opacity-100 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
            />
            <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-ink via-ink/70 to-transparent" aria-hidden="true"></div>
            <h3 class="sr-only">{f.svc.name[locale]}</h3>
            <div class="absolute inset-0 grid grid-cols-2">
              {[
                { href: localize('/services/chalets/', locale), ...c.services.split.chalets },
                { href: localize('/palace-hotels-courchevel/', locale), ...c.services.split.hotels },
              ].map((half, i) => (
                <SmartLink href={half.href} class={`group/half relative flex flex-col justify-end px-4 pb-7 no-underline transition-colors duration-300 hover:bg-brass-deep/20 focus-visible:bg-brass-deep/20 sm:px-6 ${i ? 'border-l border-brass/40' : ''}`}>
                  <span class="inline-flex min-h-11 items-center self-start bg-ink/80 px-4 font-serif text-2xl text-brass ring-1 ring-brass/60 transition-colors duration-300 group-hover/half:bg-brass-deep group-hover/half:text-ivory">{half.label}</span>
                  <span class="mt-3 text-sm text-stone">{half.line}</span>
                </SmartLink>
              ))}
            </div>
          </li>
        ) : (
          <li class="group relative overflow-hidden bg-ink">
            <Picture
              src={photos[f.image]}
              alt={f.alt}
              formats={formats}
              widths={[400, 600, 800]}
              sizes="(min-width: 768px) 33vw, 100vw"
              class="aspect-[4/5] w-full object-cover opacity-90 transition duration-700 ease-out group-hover:scale-[1.04] group-hover:opacity-100 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink via-ink/70 to-transparent px-6 pt-24 pb-7">
              <h3 class="text-3xl text-ivory">
                <SmartLink href={localize(`/services/${f.svc.slug}/`, locale)} class="text-ivory no-underline after:absolute after:inset-0 hover:text-brass">{f.svc.name[locale]}</SmartLink>
              </h3>
              <p class="mt-2 text-sm text-stone">{f.svc.summary[locale]}</p>
            </div>
          </li>
        ))}
      </ul>
      <p class="eyebrow mt-16">{c.services.more}</p>
      <ul class="mt-6 grid gap-x-12 sm:grid-cols-2 lg:grid-cols-3">
        {otherServices.map((svc) => (
          <li class="border-t border-line py-5">
            <h3 class="text-xl">
              <SmartLink href={localize(`/services/${svc.slug}/`, locale)} class="text-ink no-underline hover:text-brass-deep">{svc.name[locale]}</SmartLink>
            </h3>
            <p class="mt-1 text-sm text-taupe">{svc.summary[locale]}</p>
          </li>
        ))}
      </ul>
      <div class="mt-12">
        <a href={enquire} class="btn-primary">{s.planMyStay}</a>
      </div>
    </div>
  </section>

  <!-- Signature experiences -->
  <section id="experiences" class="border-t border-line bg-stone py-section">
    <span id="packages" aria-hidden="true"></span>
    <div class="container-site">
      <div class={sectionHead}>
        <p class="eyebrow">{c.experiences.eyebrow}</p>
        <h2 class="mt-4 text-h2">{c.experiences.title}</h2>
      </div>
    </div>
    <ul class="container-site mt-12 flex snap-x snap-mandatory gap-5 overflow-x-auto pb-4 md:grid md:grid-cols-3 md:gap-8 md:overflow-visible md:pb-0">
      {featured.map((x) => (
        <li class="w-[82%] shrink-0 snap-start md:w-auto">
          <Picture
            src={photos[x.photo ?? 'gondola']}
            alt={x.alt ?? ''}
            formats={formats}
            widths={[360, 540, 720]}
            sizes="(min-width: 768px) 33vw, 82vw"
            class="aspect-[4/5] w-full object-cover"
          />
          <h3 class="mt-6 text-3xl">
            <SmartLink href={localize('/experiences/', locale)} class="text-ink no-underline hover:text-brass-deep">{x.title}</SmartLink>
          </h3>
          <p class="mt-3 text-taupe">{x.short}</p>
        </li>
      ))}
    </ul>
    <div class="container-site mt-10">
      <SmartLink href={localize('/experiences/', locale)} class="btn-secondary">{experiencesPage[locale].hero.secondary}</SmartLink>
    </div>
  </section>

  <!-- How it works: dark band, three steps with large numerals -->
  <section class="bg-ink py-section text-ivory">
    <div class="container-site grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow text-brass">{c.steps.eyebrow}</p>
        <h2 class="mt-4 text-h2 text-ivory">{c.steps.title}</h2>
        <Picture
          src={stepsImg}
          alt={c.steps.imageAlt}
          formats={formats}
          widths={[400, 600, 800]}
          sizes="(min-width: 1024px) 28vw, 100vw"
          class="mt-10 hidden aspect-[4/5] w-full object-cover lg:block"
        />
      </div>
      <ol class="grid gap-10 md:grid-cols-3 lg:col-span-8 lg:self-end">
        {c.steps.items.map((step, i) => (
          <li class="border-t border-brass/60 pt-6">
            <span class="block font-serif text-7xl leading-none text-brass" aria-hidden="true">{pad(i + 1)}</span>
            <h3 class="mt-6 text-2xl text-ivory">{step.title}</h3>
            <p class="mt-3 text-stone/85">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Villages -->
  <section id="villages" class="border-t border-line bg-stone py-section">
    <div class="container-site grid gap-12 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-7">
        <p class="eyebrow">{c.villages.eyebrow}</p>
        <h2 class="mt-4 text-h2">{c.villages.title}</h2>
        <p class="mt-5 max-w-xl text-taupe">{c.villages.intro}</p>
        <ul class="mt-10">
          {courchevelVillages.map((v) => (
            <li class="border-t border-line py-5">
              <h3 class="text-2xl">
                <SmartLink href={localize(`/${v.slug}/`, locale)} class="text-ink no-underline hover:text-brass-deep">{v.name}</SmartLink>
              </h3>
              <p class="mt-1 text-taupe">{v.summary[locale]}</p>
            </li>
          ))}
        </ul>
      </div>
      <div class="md:col-span-5">
        <Picture
          src={villagesImg}
          alt={c.villages.imageAlt}
          formats={formats}
          widths={[400, 600, 900]}
          sizes="(min-width: 768px) 40vw, 100vw"
          class="aspect-[4/5] w-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Reviews: only rendered once real, attributed reviews exist (src/data/reviews.ts) -->
  {reviews.length > 0 && (
    <section id="testimonials" class="py-section">
      <div class="container-site grid gap-10 md:grid-cols-3">
        {reviews.map((r) => (
          <figure class="border-t border-brass pt-6">
            <blockquote class="font-serif text-2xl leading-snug">“{r.text}”</blockquote>
            <figcaption class="mt-4 text-sm text-taupe">{r.author}, {r.service[locale]}, {r.date}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <!-- Google reviews (live at build time when GOOGLE_PLACES_API_KEY is set, links otherwise).
       Takes the old site's #testimonials anchor until manual reviews exist. -->
  <section id={reviews.length > 0 ? 'google-reviews' : 'testimonials'} class="border-t border-line bg-stone py-section">
    <div class="container-site">
      <GoogleReviews locale={locale} />
    </div>
  </section>

  <!-- Guides -->
  {guides.length > 0 && (
    <section id="guides" class="border-t border-line py-section">
      <div class="container-site">
        <div class={sectionHead}>
          <p class="eyebrow">{c.guides.eyebrow}</p>
          <h2 class="mt-4 text-h2">{c.guides.title}</h2>
          <p class="mt-5 text-taupe">{c.guides.intro}</p>
        </div>
        <ul class="mt-12 grid gap-x-12 md:grid-cols-2">
          {guides.map((g) => (
            <li class="border-t border-line py-6">
              <h3 class="text-2xl"><a href={g.href} class="text-ink no-underline hover:text-brass-deep">{g.title}</a></h3>
              <p class="mt-2 text-taupe">{g.text}</p>
            </li>
          ))}
        </ul>
        <p class="mt-8"><a href={localize('/guides/', locale)} class="link inline-flex min-h-11 items-center">{c.guides.all}</a></p>
      </div>
    </section>
  )}

  <!-- About -->
  <section id="about" class="py-section">
    <div class="container-site grid items-center gap-12 md:grid-cols-12 md:gap-16">
      <div class="md:order-2 md:col-span-6">
        <p class="eyebrow">{c.about.eyebrow}</p>
        <h2 class="mt-4 text-h2">{c.about.title}</h2>
        <p class="mt-6 text-lg text-taupe">{c.about.text}</p>
        <p class="mt-8"><SmartLink href={localize('/about/', locale)} class="link">{c.about.link}</SmartLink></p>
      </div>
      <div class="md:order-1 md:col-span-6">
        <Picture
          src={aboutImg}
          alt={c.about.imageAlt}
          formats={formats}
          widths={[400, 600, 900]}
          sizes="(min-width: 768px) 50vw, 100vw"
          class="aspect-[5/4] w-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="border-t border-line py-section">
    <div class="container-site grid gap-12 md:grid-cols-12">
      <div class="md:col-span-4">
        <p class="eyebrow">{c.faq.eyebrow}</p>
        <h2 class="mt-4 text-h2">{c.faq.title}</h2>
        <p class="mt-6"><SmartLink href={localize('/faq/', locale)} class="link">{c.faq.more}</SmartLink></p>
      </div>
      <div class="md:col-span-8">
        {homeFaqs.map((f) => (
          <details class="group border-t border-line py-6 last:border-b">
            <summary class="flex min-h-11 cursor-pointer list-none items-start justify-between gap-6 py-1 font-serif text-2xl [&::-webkit-details-marker]:hidden">
              <h3 class="text-2xl">{f.q}</h3>
              <span class="mt-1 text-brass-deep transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-4 max-w-2xl text-taupe">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section id="contact" class="bg-ink text-ivory">
    <div class="mx-auto grid max-w-[96rem] md:grid-cols-2">
      <div class="flex flex-col justify-center px-5 py-section sm:px-8 md:px-12 lg:px-20">
        <h2 class="text-h2 text-ivory">{c.final.title}</h2>
        <p class="mt-6 text-lg text-stone">{c.final.text}</p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href={enquire} class="btn bg-ivory text-ink hover:bg-brass">{s.planMyStay}</a>
          <a href={whatsappHref(locale)} class="btn-light" data-event="whatsapp_click" rel="noopener">{s.whatsappUs}</a>
        </div>
      </div>
      <div class="relative aspect-[4/3] md:aspect-auto md:min-h-[36rem]">
        <Picture
          src={finalImg}
          alt={c.final.imageAlt}
          formats={formats}
          widths={[480, 720, 961]}
          sizes="(min-width: 768px) 50vw, 100vw"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>
    </div>
  </section>
</BaseLayout>
