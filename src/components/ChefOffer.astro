---
/**
 * The private chef offer on /services/private-chef/ (src/content/dining.ts):
 * three format cards, each opening the chef request with the format filled in
 * (?item=), then how it works and what we arrange around the table.
 */
import { diningCopy } from '../content/dining';
import type { Locale } from '../data/business';
import { localize } from '../lib/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { formats: f, steps, around } = diningCopy[locale];
const requestHref = (format: string) => `${localize('/enquire/chef/', locale)}?item=${encodeURIComponent(format)}`;
---

<section id="chef" class="scroll-mt-24 py-section" aria-labelledby="chef-title">
  <div class="container-site">
    <div class="max-w-2xl">
      <p class="eyebrow">{f.eyebrow}</p>
      <h2 id="chef-title" class="mt-4 text-h2">{f.title}</h2>
      <p class="mt-5 text-sm text-brass-deep">{f.festive}</p>
    </div>

    <ul class="mt-8 grid gap-3 md:mt-10 md:grid-cols-3 md:gap-6">
      {f.items.map((x, i) => (
        <li>
          <a href={requestHref(x.name)} class="group flex h-full flex-col border border-line bg-stone p-5 text-ink no-underline transition-colors hover:border-brass-deep md:p-8">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="text-2xl transition-colors group-hover:text-brass-deep md:text-3xl">{x.name}</h3>
              <span class="font-serif text-lg text-brass-deep" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <p class="mt-2 text-taupe md:mt-3">{x.line}</p>
            <span class="link mt-auto self-start pt-4 text-sm font-semibold md:pt-6">{f.request}<span class="sr-only">: {x.name}</span></span>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-16 grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <h3 class="eyebrow">{steps.title}</h3>
        <ol class="mt-6">
          {steps.items.map((s, i) => (
            <li class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-4 border-t border-line py-5">
              <span class="font-serif text-2xl text-brass-deep" aria-hidden="true">{i + 1}</span>
              <div>
                <p class="font-semibold">{s.name}</p>
                <p class="mt-1 text-taupe">{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div class="lg:col-span-5">
        <h3 class="eyebrow">{around.title}</h3>
        <ul class="mt-6">
          {around.items.map((a) => (
            <li class="border-t border-line py-4">
              <p class="font-semibold">{a.name}</p>
              <p class="mt-1 text-sm text-taupe">{a.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
