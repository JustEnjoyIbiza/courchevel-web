# Copy to .env for local development. Never commit .env.
# In production, set these in Netlify: Site configuration > Environment variables.
# Variables prefixed PUBLIC_ are exposed to the browser; everything else stays server-side
# (Netlify Functions only).

# --- Supabase (lead database) ---
SUPABASE_URL=https://your-project.supabase.co
# Server-side only, used by the Netlify Function to insert leads: the project's secret key
# (sb_secret_..., Project Settings > API Keys) or the legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# --- Basin (form backend: stores leads and emails the concierge) ---
# The form's endpoint from usebasin.com, e.g. https://usebasin.com/f/xxxxxxxx
BASIN_FORM_URL=

# --- Resend (client confirmation + concierge email) ---
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. hello@courchevelluxuryconcierge.com
LEAD_FROM_EMAIL=
# Where new-lead emails go
CONCIERGE_EMAIL=Courchevelluxuryconcierge@gmail.com

# --- Concierge alert: Telegram bot (see docs/lead-system-setup.md) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# WhatsApp Cloud API alerts are not built yet (needs a Meta business account);
# ask if you prefer them to Telegram.

# --- Cloudflare Turnstile (spam protection) ---
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Local testing only: accept leads with no service configured (never in production) ---
# LEAD_DRY_RUN=1

# --- Google reviews on the site (build time). Google Cloud > APIs > enable "Places API (New)",
# create an API key restricted to that API. Free tier covers a daily rebuild. ---
GOOGLE_PLACES_API_KEY=

# --- Cloudinary (photo library; local only, not needed on Netlify) ---
# Cloudinary console > Settings > API Keys. Used by `npm run cloudinary -- upload | pull | list`
# to sync src/assets/photos with a Cloudinary folder. The site itself still serves photos
# through the Astro image pipeline, so nothing here reaches the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder in the Cloudinary Media Library (default: courchevel)
# CLOUDINARY_FOLDER=courchevel

# --- Analytics (loaded only after cookie consent) ---
PUBLIC_GA4_MEASUREMENT_ID=

# --- IndexNow (Bing) ---
INDEXNOW_KEY=
