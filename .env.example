# Copy to .env for local development. Never commit .env.
# In production, set these in Netlify: Site configuration > Environment variables.
# Variables prefixed PUBLIC_ are exposed to the browser; everything else stays server-side
# (Netlify Functions only).

# --- Supabase (lead database) ---
SUPABASE_URL=https://your-project.supabase.co
# Service role key: server-side only, used by the Netlify Function to insert leads.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (client confirmation + concierge email) ---
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. hello@courchevelluxuryconcierge.com
LEAD_FROM_EMAIL=
# Where new-lead emails go
CONCIERGE_EMAIL=Courchevelluxuryconcierge@gmail.com

# --- Concierge alert: fill ONE of the two blocks (decision pending) ---
# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ALERT_TO=

# --- Cloudflare Turnstile (spam protection) ---
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics (loaded only after cookie consent) ---
PUBLIC_GA4_MEASUREMENT_ID=

# --- IndexNow (Bing) ---
INDEXNOW_KEY=
